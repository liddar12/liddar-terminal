# Copy to .env.local for development, or use the intended Vercel project's
# environment settings. Values below are empty on purpose. Never commit secrets.
# Both URL settings identify the reviewed SelfLearningAI Supabase project.
# Trading data is isolated by its schema, RPCs and authenticated role policies.

# Browser-visible: ONLY a publishable key (or legacy anon JWT) is safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server authentication: create the owner in Supabase Auth, then configure their
# immutable Auth user UUID. Email alone never authorizes API access.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TERMINAL_OWNER_USER_ID=

# Enable only after the additive shared-project migration and owner allowlist
# are verified. An empty/unknown value keeps trading storage disabled.
TERMINAL_STORAGE_BACKEND=
# Required value when ready: shared-trading-v1
# The trading adapter uses the verified owner's bearer + publishable key.
# It never uses SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.

# Server-only paid research provider; no trading credential belongs here.
ANTHROPIC_API_KEY=
# Optional server-selected model. Browser requests cannot override it.
# CLAUDE_MODEL=claude-haiku-4-5-20251001
