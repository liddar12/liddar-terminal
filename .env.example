# Copy to .env.local (dev) or set in Vercel project settings (prod).
# Required by api/claude.js:
ANTHROPIC_API_KEY=

# Optional: default model for the scanner proxy.
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Shared prediction store (api/log-prediction, api/predictions, api/scores).
# Until these are set those routes answer 503 "storage not configured".
# Schema: SelfLearning repo, packages/selflearn-core/selflearn_core/store/schema.postgres.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
